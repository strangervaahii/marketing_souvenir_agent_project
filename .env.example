APP_ENV=dev
DATABASE_URL=sqlite:///./orders.db

# mock keeps the complete workflow runnable without an LLM.
# For the real hackathon, use http and configure your in-house endpoint.
LLM_MODE=mock
LLM_BASE_URL=http://localhost:8001
LLM_API_KEY=
LLM_MODEL=in-house-model
LLM_TIMEOUT_SECONDS=30

# Conservative, configurable low-risk policy.
AUTO_DISPATCH_MAX_TOTAL=500
MIN_RECONCILIATION_CONFIDENCE=0.90
